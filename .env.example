VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
# The hosted Supabase project. Leave empty to run local-only, with no login UI.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# The canonical origin for canonical, Open Graph and sitemap URLs. Empty: the production address.
VITE_SITE_URL=
# Exactly "true" lets search engines index the public pages and fills sitemap.xml. Anything else
# keeps every page noindex. Production stays unset until the owner's launch checklist is done.
VITE_PUBLIC_INDEXING_ENABLED=
