// Deploys build/client/ to Cloudflare Workers as static assets. With this file in the repo, Workers Builds
// uses it as is instead of generating a config (and adding dependencies) on every build.
{
  "name": "dsa-learning",
  "compatibility_date": "2026-09-26",
  "assets": {
    "directory": "./build/client",
    // Practice addresses get the app shell through _redirects (scripts/static-output.ts); any
    // other address with no file gets 404.html with a 404 status.
    "not_found_handling": "404-page",
    // Prerendered pages are folders (privacy/index.html); serve them at /privacy, no slash.
    "html_handling": "drop-trailing-slash",
  },
  // The canonical address. Cloudflare creates its DNS record and HTTPS certificate.
  "routes": [{ "pattern": "dsa-learning.bernardosevero.dev", "custom_domain": true }],
  // Explicit because a route makes Wrangler turn workers.dev off. The old address stays up so a log
  // stored there can still be exported, and the branch Preview URLs live on workers.dev.
  "workers_dev": true,
  "preview_urls": true,
  // Required by `npx wrangler preview` (the preview builds). Empty: previews need no own settings.
  "previews": {},
}
